@page "/account/change-password"
@model NexusAuth.Host.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "修改密码";
}

<main class="account-panel">
    <h1>修改密码</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="message error" role="alert">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p class="message success" role="status">@Model.StatusMessage</p>
    }

    <form method="post">
        <label asp-for="CurrentPassword">当前密码</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" type="password" required />

        <label asp-for="NewPassword">新密码</label>
        <input asp-for="NewPassword" autocomplete="new-password" type="password" required />

        <label asp-for="ConfirmNewPassword">确认新密码</label>
        <input asp-for="ConfirmNewPassword" autocomplete="new-password" type="password" required />

        <button type="submit">保存新密码</button>
    </form>
</main>

<style>
    .account-panel { max-width: 420px; margin: 72px auto; padding: 28px; font-family: system-ui, sans-serif; }
    h1 { margin-top: 0; }
    label, input { display: block; width: 100%; }
    label { margin-top: 16px; margin-bottom: 6px; }
    input { box-sizing: border-box; padding: 10px; }
    button { margin-top: 24px; padding: 10px 16px; }
    .message { padding: 10px; }
    .error { color: #a40000; background: #fde8e8; }
    .success { color: #146c2e; background: #e8f6eb; }
</style>
