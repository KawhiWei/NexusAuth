@page "/account/change-password"
@model NexusAuth.Host.Pages.Account.ChangePasswordModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "登录密码";
}
<section class="panel security-summary" aria-label="账号安全状态">
    <div class="score" aria-hidden="true">✓</div><div class="summary-copy"><strong>账号已受到密码保护</strong><span>当前安全设置有效，请定期更新访问凭据。</span></div><div class="summary-badge">安全状态正常</div>
</section>
<section class="panel password-panel" aria-labelledby="password-title">
    <div class="section-heading"><div><h1 id="password-title">修改登录密码</h1><p>验证当前密码后，为账号设置新的登录密码。</p></div><span class="status-chip"><span class="status-dot"></span>密码已设置</span></div>
    <p class="password-notice">安全设置由 NexusAuth 统一管理。密码更新后，部分应用可能要求重新登录。</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="message error" role="alert">@Model.ErrorMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="message success" role="status">@Model.StatusMessage</div> }
    <form class="password-form" method="post">
        <div class="field"><label class="field-label" asp-for="CurrentPassword">当前密码</label><div class="field-content"><div class="password-wrap"><input class="password-input" asp-for="CurrentPassword" autocomplete="current-password" placeholder="请输入当前密码" type="password" required /><button class="password-toggle" type="button" data-password-toggle="CurrentPassword" aria-label="显示当前密码">◉</button></div></div></div>
        <div class="field"><label class="field-label" asp-for="NewPassword">新密码</label><div class="field-content"><div class="password-wrap"><input class="password-input" asp-for="NewPassword" autocomplete="new-password" placeholder="请输入新密码" type="password" required /><button class="password-toggle" type="button" data-password-toggle="NewPassword" aria-label="显示新密码">◉</button></div><p class="field-help">建议至少 8 位，并组合使用字母、数字与符号。</p></div></div>
        <div class="field"><label class="field-label" asp-for="ConfirmNewPassword">确认新密码</label><div class="field-content"><div class="password-wrap"><input class="password-input" asp-for="ConfirmNewPassword" autocomplete="new-password" placeholder="请再次输入新密码" type="password" required /><button class="password-toggle" type="button" data-password-toggle="ConfirmNewPassword" aria-label="显示确认密码">◉</button></div></div></div>
        <div class="form-actions"><button class="primary-button" type="submit">保存新密码</button><span class="action-note">保存后，其他应用可能需要重新验证身份。</span></div>
    </form>
</section>
