@page "/account"
@model NexusAuth.Host.Pages.Account.IndexModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "账号主页";
}
<section class="panel home" aria-labelledby="account-title">
    <h1 id="account-title">你好，@Model.DisplayName</h1>
    <p>这里是你的 NexusAuth 账号安全中心。</p>
    <div class="actions">
        <a class="action" href="/account/change-password"><strong>修改登录密码</strong><span>更新密码后会撤销现有刷新令牌和登录会话。</span></a>
        <a class="action" href="/account/two-factor"><strong>身份验证器</strong><span>绑定 TOTP 动态验证码，为登录增加第二步验证。</span></a>
        <a class="action" href="/account/login-history"><strong>查看登录记录</strong><span>查看当前账号最近的成功登录来源与时间。</span></a>
    </div>
</section>
