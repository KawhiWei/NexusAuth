@page
@model NexusAuth.Host.Pages.Account.LoginModel
@{
    Layout = null;
    var logoUrlSeparator = Model.LoginPage.BrandLogoUrl.Contains('?') ? "&" : "?";
    var loginBrandLogoUrl = $"{Model.LoginPage.BrandLogoUrl}{logoUrlSeparator}v=2";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NexusAuth 登录中心</title>
    <link rel="icon" type="image/svg+xml" href="/brand/nexusauth-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&amp;family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <script>
        (function () {
            const key = 'nexusauth-login-theme';
            const stored = window.localStorage.getItem(key);
            const theme = stored === 'light' || stored === 'dark'
                ? stored
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.classList.add(theme);
        })();
    </script>
    <style>
        :root, html.light {
            --page-bg: #f8fafc; --panel-bg: #edf7ff; --grid: #b6d6ef;
            --tech-foreground: #10273b; --tech-muted: #587087; --tech-line: #2c7cb9;
            --tech-glow: #2589d622; --tech-node: #176caa; --stat-bg: #ffffff99;
            --stat-border: #b9d7ee; --form-heading: #102030; --form-muted: #627282;
            --field-bg: #ffffff; --border: #d6dee6; --brand-blue: #2f8fe5;
            --button-text: #ffffff; --danger: #9f1239; --danger-bg: #fff1f2;
            --danger-border: #fecdd3; color-scheme: light;
        }
        html.dark {
            --page-bg: #10151b; --panel-bg: #05080d; --grid: #172737;
            --tech-foreground: #f4faff; --tech-muted: #7b9bb5; --tech-line: #3f9ef2;
            --tech-glow: #1479ce1f; --tech-node: #d9f0ff; --stat-bg: #ffffff0a;
            --stat-border: #ffffff1a; --form-heading: #f2f7fc; --form-muted: #91a1b1;
            --field-bg: #171e26; --border: #2d3945; --brand-blue: #54a9f4;
            --button-text: #07121f; --danger: #fda4af; --danger-bg: #4c051933;
            --danger-border: #9f123980; color-scheme: dark;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body { min-width: 320px; background: var(--page-bg); color: var(--form-heading); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
        button, input { font: inherit; }
        button, a { -webkit-tap-highlight-color: transparent; }
        .auth-shell { min-height: 100dvh; display: grid; grid-template-columns: minmax(0, 58.854%) minmax(0, 41.146%); background: var(--page-bg); }
        .visual-panel { position: relative; min-height: 100dvh; overflow: hidden; color: var(--tech-foreground); background-color: var(--panel-bg); background-image: linear-gradient(to right, var(--grid) 1px, transparent 1px), linear-gradient(to bottom, var(--grid) 1px, transparent 1px); background-position: 70px 0, 0 92px; background-size: 120px 100%, 100% 120px; }
        .visual-panel::after { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 0 82%, color-mix(in srgb, var(--panel-bg) 55%, transparent)); content: ""; pointer-events: none; }
        .brand-lockup { position: absolute; top: 6.85%; left: 8.15%; z-index: 2; display: flex; align-items: center; gap: 13px; color: var(--tech-foreground); }
        .brand-mark-shell { display: grid; width: 50px; height: 50px; place-items: center; overflow: hidden; }
        .brand-mark-shell img { width: 50px; height: 50px; }
        .brand-word { font-family: Geist, Inter, sans-serif; font-size: 19px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
        .system-label { position: absolute; top: 26.1%; left: 8.3%; z-index: 2; display: flex; align-items: center; gap: 8px; color: var(--tech-muted); font-size: 11px; font-weight: 700; letter-spacing: 1.3px; }
        .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #6beeb1; box-shadow: 0 0 12px #6beeb199; }
        .hero-copy { position: absolute; top: 31.1%; left: 8.15%; z-index: 2; width: min(49%, 555px); }
        .hero-copy h1 { margin: 0; color: var(--tech-foreground); font-family: Geist, Inter, sans-serif; font-size: clamp(42px, 3vw, 58px); font-weight: 700; letter-spacing: 0; line-height: 1.08; }
        .hero-copy p { max-width: 480px; margin: 23px 0 0; color: var(--tech-muted); font-size: clamp(15px, 1vw, 19px); line-height: 1.5; }
        .network { position: absolute; top: 22%; left: 55.6%; z-index: 1; width: min(37.2vw, 420px); aspect-ratio: 1; border-radius: 50%; background: var(--tech-glow); }
        .orbit { position: absolute; top: 50%; left: 50%; border: 1px solid var(--tech-line); border-radius: 50%; transform: translate(-50%, -50%); }
        .orbit.outer { width: 68.1%; height: 68.1%; opacity: .75; }
        .orbit.inner { width: 41%; height: 41%; opacity: .85; }
        .signal-core { position: absolute; top: 50%; left: 50%; width: 8.1%; aspect-ratio: 1; border-radius: 50%; background: var(--brand-blue); box-shadow: 0 0 24px 4px color-mix(in srgb, var(--brand-blue) 55%, transparent); transform: translate(-50%, -50%); }
        .orbit-node { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--tech-node); }
        .node-one { top: 42.8%; left: 21.4%; } .node-two { top: 36.7%; right: 29%; } .node-three { right: 30.5%; bottom: 25.2%; } .node-four { bottom: 21.4%; left: 32.4%; }
        .stats { position: absolute; left: 8.3%; bottom: 18.35%; z-index: 2; display: grid; width: min(50.5%, 570px); min-width: 490px; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--stat-border); border-radius: 8px; background: var(--stat-bg); backdrop-filter: blur(8px); }
        .stat { min-width: 0; padding: 24px 26px; } .stat + .stat { border-left: 1px solid var(--stat-border); }
        .stat strong { display: block; color: var(--tech-foreground); font-family: Geist, Inter, sans-serif; font-size: 24px; font-weight: 600; }
        .stat span { display: block; margin-top: 8px; color: var(--tech-muted); font-size: 10px; font-weight: 700; letter-spacing: .9px; }
        .panel-footer { position: absolute; right: 9.4%; bottom: 7.1%; left: 8.3%; z-index: 2; display: flex; justify-content: space-between; color: var(--tech-muted); font-size: 10px; font-weight: 600; letter-spacing: 1px; }
        .form-panel { position: relative; min-width: 0; min-height: 100dvh; overflow-y: auto; background: var(--page-bg); }
        .utility-row { position: absolute; top: 68px; right: clamp(36px, 5.52vw, 106px); z-index: 4; }
        .theme-toggle { position: relative; display: grid; width: 78px; height: 34px; grid-template-columns: 1fr 1fr; align-items: center; padding: 3px; border: 1px solid var(--border); border-radius: 17px; color: var(--form-muted); background: var(--field-bg); cursor: pointer; }
        .theme-toggle::before { position: absolute; top: 2px; left: 2px; width: 28px; height: 28px; border-radius: 50%; background: var(--brand-blue); content: ""; transition: transform 180ms ease; }
        html.dark .theme-toggle::before { transform: translateX(44px); }
        .theme-icon { position: relative; z-index: 1; display: grid; place-items: center; } .theme-icon svg { width: 14px; height: 14px; }
        html.light .theme-icon.sun, html.dark .theme-icon.moon { color: var(--button-text); }
        .mobile-brand { display: none; }
        .login-content { width: min(calc(100% - 72px), 578px); margin: 0 auto; padding: clamp(210px, 22.2vh, 240px) 0 64px; }
        .eyebrow { margin: 0 0 8px; color: var(--brand-blue); font-size: 11px; font-weight: 700; letter-spacing: 1.4px; }
        .form-title { margin: 0; color: var(--form-heading); font-family: Geist, Inter, sans-serif; font-size: clamp(34px, 2.04vw, 39px); font-weight: 700; letter-spacing: 0; line-height: 1.15; }
        .form-subtitle { margin: 10px 0 0; color: var(--form-muted); font-size: 15px; line-height: 1.5; }
        .auth-error { margin: 24px 0 0; padding: 12px 14px; border: 1px solid var(--danger-border); border-radius: 6px; color: var(--danger); background: var(--danger-bg); font-size: 13px; line-height: 1.5; }
        .login-form { display: flex; flex-direction: column; gap: 20px; margin-top: 42px; } .auth-error + .login-form { margin-top: 24px; }
        .form-field { display: flex; flex-direction: column; gap: 9px; }
        .field-label-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
        .field-label, .field-label-row label { color: var(--form-heading); font-size: 11px; font-weight: 700; letter-spacing: .8px; line-height: 1.2; text-transform: uppercase; }
        .field-meta { color: var(--brand-blue); font-size: 12px; font-weight: 600; }
        .input-wrap { position: relative; }
        .input-icon { position: absolute; top: 50%; left: 17px; display: grid; width: 18px; height: 18px; place-items: center; color: var(--form-muted); pointer-events: none; transform: translateY(-50%); }
        .input-icon svg { width: 18px; height: 18px; }
        .login-input { display: block; width: 100%; height: 56px; padding: 0 48px; border: 1px solid var(--border); border-radius: 6px; outline: none; color: var(--form-heading); background: var(--field-bg); font-size: 15px; transition: border-color 160ms ease, box-shadow 160ms ease; }
        .login-input::placeholder { color: var(--form-muted); opacity: .92; }
        .login-input:focus { border-color: var(--brand-blue); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-blue) 20%, transparent); }
        .login-input:-webkit-autofill { -webkit-box-shadow: 0 0 0 1000px var(--field-bg) inset; -webkit-text-fill-color: var(--form-heading); }
        .password-toggle { position: absolute; top: 50%; right: 10px; display: grid; width: 36px; height: 36px; place-items: center; padding: 0; border: 0; border-radius: 4px; color: var(--form-muted); background: transparent; cursor: pointer; transform: translateY(-50%); }
        .password-toggle:hover { color: var(--form-heading); background: color-mix(in srgb, var(--form-muted) 10%, transparent); } .password-toggle svg { width: 18px; height: 18px; }
        .remember-row { min-height: 18px; } .remember-label { display: inline-flex; align-items: center; gap: 9px; color: var(--form-muted); font-size: 13px; cursor: pointer; }
        .remember-label input { width: 18px; height: 18px; margin: 0; accent-color: var(--brand-blue); }
        .login-submit { display: flex; width: 100%; height: 56px; align-items: center; justify-content: center; gap: 10px; padding: 0 20px; border: 0; border-radius: 6px; color: var(--button-text); background: var(--brand-blue); font-size: 15px; font-weight: 700; cursor: pointer; transition: filter 160ms ease, transform 160ms ease; }
        .login-submit:hover { filter: brightness(.94); } .login-submit:active { transform: translateY(1px); } .login-submit svg { width: 18px; height: 18px; }
        .totp-input { padding: 0 16px; text-align: center; font-size: 24px; letter-spacing: 4px; }
        .totp-help { margin: 0; color: var(--form-muted); font-size: 13px; line-height: 1.5; }
        .restart-link { color: var(--brand-blue); font-size: 13px; font-weight: 600; text-align: center; text-decoration: none; }
        .client-name { margin-top: 28px; color: var(--form-muted); font-size: 12px; text-align: center; } .client-name strong { color: var(--form-heading); }
        :where(.theme-toggle, .password-toggle, .login-submit, .restart-link, .captcha-close, .captcha-handle):focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 3px; }
        .slider-captcha-dialog { position: fixed; inset: 0; z-index: 2147483647; display: flex; align-items: center; justify-content: center; padding: 16px; background: #000000a6; }
        .slider-captcha-dialog.hidden { display: none; }
        .captcha-card { width: min(100%, 420px); padding: 24px; border: 1px solid var(--border); border-radius: 8px; background: var(--page-bg); box-shadow: 0 24px 60px #0006; }
        .captcha-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
        .captcha-header h2 { margin: 0; color: var(--form-heading); font-family: Geist, sans-serif; font-size: 18px; } .captcha-header p { margin: 5px 0 0; color: var(--form-muted); font-size: 14px; }
        .captcha-close { border: 0; color: var(--form-muted); background: transparent; font-size: 24px; cursor: pointer; }
        .slider-captcha-scene { position: relative; width: 100%; height: 160px; overflow: hidden; border: 1px solid #ffffff33; border-radius: 6px; background: linear-gradient(125deg, #2f8fe5eb, #2563ebcc), repeating-linear-gradient(45deg, #ffffff24 0 2px, transparent 2px 14px); }
        .captcha-stars { position: absolute; inset: 0; opacity: .4; background-image: radial-gradient(circle at 16% 25%, white 0 2px, transparent 3px), radial-gradient(circle at 75% 72%, white 0 3px, transparent 4px), linear-gradient(135deg, transparent 42%, #ffffff6b 43% 47%, transparent 48%); }
        .captcha-gap, .slider-captcha-piece { position: absolute; top: 52px; width: 44px; height: 44px; border-radius: 6px; }
        .captcha-gap { border: 2px dashed #ffffffcc; background: #0003; }
        .slider-captcha-piece { left: 0; border: 1px solid #ffffffcc; background: #ffffff59; box-shadow: 0 8px 18px #00000047; backdrop-filter: blur(4px); will-change: transform; }
        .captcha-track { position: relative; height: 48px; margin-top: 20px; border-radius: 6px; overflow: hidden; background: color-mix(in srgb, var(--field-bg) 75%, var(--border)); user-select: none; }
        .captcha-progress { position: absolute; inset: 0 auto 0 0; border-radius: 6px; background: color-mix(in srgb, var(--brand-blue) 30%, transparent); transform-origin: left center; will-change: transform; }
        .captcha-instruction { position: absolute; inset: 0; display: grid; place-items: center; color: var(--form-muted); font-size: 13px; pointer-events: none; }
        .captcha-handle { position: absolute; top: 0; left: 0; display: grid; width: 48px; height: 48px; place-items: center; border: 0; border-radius: 6px; color: var(--button-text); background: var(--brand-blue); box-shadow: 0 4px 12px #0004; cursor: grab; touch-action: none; will-change: transform; }
        .captcha-status { min-height: 20px; margin: 12px 0 0; color: var(--form-muted); font-size: 13px; text-align: center; }
        @@media (max-width: 1099px) {
            .auth-shell { display: block; } .visual-panel { display: none; }
            .form-panel { min-height: 100dvh; padding: 0 24px; } .utility-row { top: 24px; right: 24px; }
            .mobile-brand { position: absolute; top: 24px; left: 24px; display: flex; align-items: center; gap: 11px; color: var(--form-heading); text-decoration: none; }
            .mobile-brand .brand-word { font-size: 17px; }
            .login-content { width: min(100%, 560px); padding: 150px 0 56px; }
        }
        @@media (max-width: 600px) {
            .form-panel { padding: 0 20px; } .mobile-brand { top: 20px; left: 20px; } .utility-row { top: 20px; right: 20px; }
            .login-content { padding-top: 122px; } .form-title { font-size: 31px; } .form-subtitle { font-size: 14px; } .login-form { margin-top: 34px; }
        }
        @@media (min-width: 1100px) and (max-height: 850px) {
            .utility-row { top: 28px; } .login-content { padding-top: 120px; } .hero-copy { top: 28%; } .stats { bottom: 14%; } .panel-footer { bottom: 4%; }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <aside class="visual-panel" aria-label="NexusAuth product overview">
            <div class="brand-lockup"><span class="brand-mark-shell"><img src="@loginBrandLogoUrl" alt="" /></span><span class="brand-word">@Model.LoginPage.BrandName</span></div>
            <div class="system-label"><span class="live-dot"></span><span>OAUTH 2.1 / OPENID CONNECT</span></div>
            <div class="hero-copy"><h1>@Model.LoginPage.MarketingHeading</h1><p>@Model.LoginPage.MarketingDescription</p></div>
            <div class="network" aria-hidden="true"><span class="orbit outer"></span><span class="orbit inner"></span><span class="signal-core"></span><span class="orbit-node node-one"></span><span class="orbit-node node-two"></span><span class="orbit-node node-three"></span><span class="orbit-node node-four"></span></div>
            <div class="stats" aria-label="支持的标准协议"><div class="stat"><strong>OAuth 2.1</strong><span>授权协议</span></div><div class="stat"><strong>OIDC</strong><span>身份认证</span></div><div class="stat"><strong>SCIM 2.0</strong><span>用户配置</span></div></div>
            <div class="panel-footer"><span>AUTHORIZATION CODE / PKCE</span><span>NEXUSAUTH SSO</span></div>
        </aside>
        <main class="form-panel">
            <div class="mobile-brand"><span class="brand-mark-shell"><img src="@loginBrandLogoUrl" alt="" /></span><span class="brand-word">@Model.LoginPage.BrandName</span></div>
            <div class="utility-row"><button id="theme-toggle" type="button" class="theme-toggle" aria-label="切换主题" title="切换主题"><span class="theme-icon sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg></span><span class="theme-icon moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg></span></button></div>
            <section class="login-content" aria-labelledby="login-title">
                <p class="eyebrow">@Model.LoginPage.BrandName</p>
                <h1 id="login-title" class="form-title">@(Model.RequiresTotp ? "验证身份" : Model.LoginPage.LoginTitle)</h1>
                <p class="form-subtitle">@(Model.RequiresTotp ? "输入身份验证器应用当前显示的六位代码。" : Model.LoginPage.LoginSubtitle)</p>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-error" role="alert">@Model.ErrorMessage</div>
                }
                @if (Model.RequiresTotp)
                {
                    <form class="login-form" method="post" asp-page-handler="Totp">
                        <input type="hidden" asp-for="FlowToken" />
                        <div class="form-field"><div class="field-label-row"><label asp-for="TotpCode">身份验证器代码</label><span class="field-meta">第二步</span></div><input class="login-input totp-input" asp-for="TotpCode" autocomplete="one-time-code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="000000" required autofocus /><p class="totp-help">输入身份验证器应用当前显示的六位代码。</p></div>
                        <button class="login-submit" type="submit">验证并登录</button>
                        <a class="restart-link" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">重新开始</a>
                    </form>
                }
                else
                {
                    <form id="login-form" class="login-form" method="post">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        @if (Model.SliderCaptchaEnabled)
                        {
                            <input id="slider-captcha-token" type="hidden" asp-for="SliderCaptchaToken" />
                            <input id="slider-captcha-offset" type="hidden" asp-for="SliderCaptchaOffset" />
                        }
                        <div class="form-field"><label class="field-label" for="username">Username or Email</label><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg></span><input class="login-input" id="username" name="Username" autocomplete="username" placeholder="admin@nexusauth.local" required type="text" value="@Model.Username" autofocus /></div></div>
                        <div class="form-field"><div class="field-label-row"><label for="password">Password</label><span class="field-meta">安全接入</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><input class="login-input" id="password" name="Password" autocomplete="current-password" placeholder="••••••••" required type="password" /><button class="password-toggle" type="button" id="password-toggle" aria-label="显示密码"><span id="password-toggle-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></span></button></div></div>
                        @if (Model.ShowRememberMe)
                        {
                            <div class="remember-row"><label class="remember-label"><input asp-for="RememberMe" type="checkbox" />@Model.RememberMeLifetimeDays 天内免登录</label></div>
                        }
                        <button class="login-submit" type="submit"><span>@Model.LoginPage.LoginTitle</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
                    </form>
                    @if (Model.SliderCaptchaEnabled)
                    {
                        <div id="slider-captcha-dialog" class="slider-captcha-dialog hidden" role="dialog" aria-modal="true" aria-labelledby="slider-captcha-title">
                            <div class="captcha-card"><div class="captcha-header"><div><h2 id="slider-captcha-title">安全验证</h2><p>拖动滑块，将拼图移动到缺口位置。</p></div><button id="slider-captcha-close" type="button" class="captcha-close" aria-label="关闭验证">&times;</button></div><div id="slider-captcha-scene" class="slider-captcha-scene" data-target="@Model.SliderCaptchaTargetOffsetPixels" data-tolerance="@Model.SliderCaptchaTolerancePixels" data-track-width="@Model.SliderCaptchaTrackWidthPixels"><div class="captcha-stars"></div><div id="slider-captcha-gap" class="captcha-gap" aria-hidden="true"></div><div id="slider-captcha-piece" class="slider-captcha-piece" aria-hidden="true"></div></div><div id="slider-captcha-track" class="captcha-track" aria-label="拖动完成安全验证"><div id="slider-captcha-progress" class="captcha-progress"></div><span class="captcha-instruction">按住滑块向右拖动</span><button id="slider-captcha-handle" type="button" class="captcha-handle" aria-label="拖动滑块"><span aria-hidden="true">&raquo;</span></button></div><p id="slider-captcha-status" class="captcha-status" aria-live="polite"></p></div>
                        </div>
                    }
                }
                @if (!string.IsNullOrEmpty(Model.AuthorizationClientDisplayName))
                {
                    <div class="client-name">当前授权客户端：<strong>@Model.AuthorizationClientDisplayName</strong></div>
                }
            </section>
        </main>
    </div>
    <script>
        (function () {
            const root = document.documentElement;
            const toggle = document.getElementById('theme-toggle');
            const storageKey = 'nexusauth-login-theme';
            function applyTheme(theme) {
                root.classList.remove('light', 'dark'); root.classList.add(theme);
                toggle.setAttribute('aria-label', theme === 'dark' ? '切换至亮色模式' : '切换至暗色模式');
            }
            applyTheme(root.classList.contains('dark') ? 'dark' : 'light');
            toggle.addEventListener('click', function () {
                const next = root.classList.contains('dark') ? 'light' : 'dark';
                window.localStorage.setItem(storageKey, next); applyTheme(next);
            });
            const passwordInput = document.getElementById('password');
            const passwordToggle = document.getElementById('password-toggle');
            const passwordToggleIcon = document.getElementById('password-toggle-icon');
            passwordToggle?.addEventListener('click', function () {
                const showing = passwordInput.type === 'text'; passwordInput.type = showing ? 'password' : 'text';
                passwordToggle.setAttribute('aria-label', showing ? '显示密码' : '隐藏密码');
                passwordToggleIcon.innerHTML = showing
                    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>'
                    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 3 18 18"/><path d="M10.6 6.1A12 12 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-2.3 3.1M6.2 6.2C3.5 8 2 12 2 12s3.5 6 10 6c1.4 0 2.6-.3 3.7-.7"/></svg>';
            });
            const form = document.getElementById('login-form');
            const dialog = document.getElementById('slider-captcha-dialog');
            if (!form || !dialog) return;
            document.body.appendChild(dialog);
            const scene = document.getElementById('slider-captcha-scene');
            const gap = document.getElementById('slider-captcha-gap');
            const piece = document.getElementById('slider-captcha-piece');
            const track = document.getElementById('slider-captcha-track');
            const handle = document.getElementById('slider-captcha-handle');
            const progress = document.getElementById('slider-captcha-progress');
            const offsetInput = document.getElementById('slider-captcha-offset');
            const status = document.getElementById('slider-captcha-status');
            const close = document.getElementById('slider-captcha-close');
            let verified = false, dragging = false, startX = 0, currentOffset = 0;
            let trackTravel = 0, sceneTravel = 0, handleWidth = 0, pendingOffset = 0, animationFrame = 0;
            function measure() { handleWidth = handle.clientWidth; trackTravel = Math.max(0, track.clientWidth - handleWidth); sceneTravel = Math.max(0, scene.clientWidth - piece.clientWidth); progress.style.width = `${track.clientWidth}px`; }
            function setPosition(offset) {
                currentOffset = Math.max(0, Math.min(trackTravel, offset));
                const configuredWidth = Number(scene.dataset.trackWidth);
                const normalizedOffset = trackTravel === 0 ? 0 : Math.round(currentOffset / trackTravel * configuredWidth);
                const ratio = trackTravel === 0 ? 0 : currentOffset / trackTravel;
                handle.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
                progress.style.transform = `scaleX(${Math.min(1, (currentOffset + handleWidth) / Math.max(1, track.clientWidth))})`;
                piece.style.transform = `translate3d(${ratio * sceneTravel}px, 0, 0)`;
                offsetInput.value = normalizedOffset;
            }
            function queuePosition(offset) { pendingOffset = offset; if (animationFrame) return; animationFrame = window.requestAnimationFrame(function () { animationFrame = 0; setPosition(pendingOffset); }); }
            function prepare() {
                verified = false; offsetInput.value = ''; status.textContent = ''; measure(); piece.style.left = '0px'; setPosition(0);
                const configuredWidth = Number(scene.dataset.trackWidth);
                gap.style.left = `${Number(scene.dataset.target) / configuredWidth * (scene.clientWidth - gap.clientWidth)}px`;
            }
            function openDialog() { dialog.classList.remove('hidden'); window.requestAnimationFrame(function () { prepare(); handle.focus(); }); }
            function closeDialog() { dialog.classList.add('hidden'); }
            form.addEventListener('submit', function (event) { if (!verified) { event.preventDefault(); openDialog(); } });
            handle.addEventListener('pointerdown', function (event) { dragging = true; startX = event.clientX - currentOffset; handle.setPointerCapture(event.pointerId); });
            handle.addEventListener('pointermove', function (event) { if (dragging) queuePosition(event.clientX - startX); });
            handle.addEventListener('pointerup', function (event) {
                if (!dragging) return; dragging = false; handle.releasePointerCapture(event.pointerId);
                if (animationFrame) { window.cancelAnimationFrame(animationFrame); animationFrame = 0; }
                setPosition(event.clientX - startX);
                const passed = Math.abs(Number(offsetInput.value) - Number(scene.dataset.target)) <= Number(scene.dataset.tolerance);
                if (passed) { verified = true; status.textContent = '验证通过，正在提交...'; window.setTimeout(function () { closeDialog(); form.requestSubmit(); }, 180); return; }
                status.textContent = '请将拼图对准缺口后重试。'; window.setTimeout(function () { setPosition(0); }, 300);
            });
            close.addEventListener('click', closeDialog);
            window.addEventListener('resize', function () { if (!dialog.classList.contains('hidden')) prepare(); });
        })();
    </script>
</body>
</html>
