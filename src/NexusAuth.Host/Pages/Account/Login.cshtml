@page
@model NexusAuth.Host.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="dark" lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NexusAuth 登录中心</title>
    <link rel="icon" type="image/svg+xml" href="/brand/nexusauth-logo.svg" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600&amp;family=Manrope:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        tertiary: "#ffaaf7",
                        "on-secondary-fixed-variant": "#3a45ac",
                        "surface-variant": "#1a2056",
                        "primary-fixed": "#799dff",
                        outline: "#6e729d",
                        "tertiary-fixed": "#f797f0",
                        "tertiary-dim": "#e88ae1",
                        "on-secondary-container": "#c9cdff",
                        "outline-variant": "#41456c",
                        "on-tertiary-container": "#610e63",
                        "on-error-container": "#ffa8a3",
                        "on-tertiary-fixed-variant": "#6c1a6c",
                        "primary-container": "#799dff",
                        "secondary": "#8a95ff",
                        "on-primary-fixed-variant": "#00276c",
                        "tertiary-fixed-dim": "#e88ae1",
                        "on-secondary-fixed": "#19248e",
                        "secondary-fixed-dim": "#babfff",
                        "error-dim": "#d7383b",
                        "tertiary-container": "#f797f0",
                        "surface-tint": "#156aff"
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem"
                    },
                    fontFamily: {
                        headline: ["Space Grotesk"],
                        body: ["Inter"],
                        label: ["Manrope"]
                    }
                }
            }
        };
    </script>
    <style>
        html.dark {
            --page-bg: #020617;
            --brand-bg: #0f172a;
            --card-bg: #0f172a;
            --field-bg: #020617;
            --on-surface: #ffffff;
            --on-surface-variant: #cbd5e1;
            --outline: #64748b;
            --outline-variant: #334155;
            --primary: #004ac6;
            --primary-hover: #003ea8;
            --danger: #fca5a5;
            --danger-bg: rgba(127, 29, 29, 0.35);
            color-scheme: dark;
        }

        html.light {
            --page-bg: #faf8ff;
            --brand-bg: #f2f3ff;
            --card-bg: #ffffff;
            --field-bg: #faf8ff;
            --on-surface: #131b2e;
            --on-surface-variant: #434655;
            --outline: #737686;
            --outline-variant: #c3c6d7;
            --primary: #004ac6;
            --primary-hover: #003ea8;
            --danger: #93000a;
            --danger-bg: #ffdad6;
            color-scheme: light;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: max(884px, 100dvh);
            background: var(--page-bg);
            color: var(--on-surface);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button,
        input {
            font: inherit;
        }

        .auth-shell {
            min-height: max(884px, 100dvh);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--page-bg);
        }

        .brand-corner {
            position: fixed;
            top: 24px;
            left: 24px;
            z-index: 50;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--primary);
            font-size: 18px;
            font-weight: 700;
            line-height: 1.2;
            text-decoration: none;
        }

        .theme-toggle {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 50;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            padding: 8px;
            border: 0;
            border-radius: 999px;
            color: var(--on-surface-variant);
            background: transparent;
            cursor: pointer;
            transition: background-color 160ms ease, color 160ms ease;
        }

        .theme-toggle:hover {
            color: var(--on-surface);
            background: color-mix(in srgb, var(--on-surface) 8%, transparent);
        }

        .theme-toggle:focus-visible,
        .password-toggle:focus-visible,
        .slider-captcha-dialog button:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .theme-toggle svg {
            width: 20px;
            height: 20px;
        }

        .auth-brand-panel {
            display: none;
        }

        .auth-form-panel {
            position: relative;
            display: flex;
            flex: 1;
            min-width: 0;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 64px 16px 32px;
            background: var(--page-bg);
        }

        .mobile-brand {
            position: absolute;
            top: 40px;
            left: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-mark {
            display: block;
            width: 32px;
            height: 32px;
            border-radius: 4px;
            object-fit: cover;
        }

        .mobile-brand-name,
        .card-mobile-brand,
        .brand-name {
            color: var(--primary);
            font-weight: 700;
        }

        .mobile-brand-name,
        .card-mobile-brand {
            font-size: 20px;
            line-height: 1.4;
        }

        .auth-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 480px;
            margin-top: 40px;
            padding: 24px;
            border: 1px solid color-mix(in srgb, var(--outline-variant) 30%, transparent);
            border-radius: 12px;
            background: var(--card-bg);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        }

        .auth-card-header {
            margin-bottom: 24px;
        }

        .card-mobile-brand {
            margin-bottom: 8px;
            text-align: center;
        }

        .auth-card-title {
            margin: 0 0 4px;
            color: var(--on-surface);
            font-size: 24px;
            font-weight: 600;
            line-height: 1.3;
        }

        .auth-card-subtitle {
            margin: 0;
            color: var(--on-surface-variant);
            font-size: 12px;
            line-height: 1.5;
        }

        .mobile-only {
            display: none;
        }

        .auth-error {
            margin: 0 0 24px;
            padding: 12px 16px;
            border: 1px solid color-mix(in srgb, var(--danger) 40%, transparent);
            border-radius: 8px;
            color: var(--danger);
            background: var(--danger-bg);
            font-size: 14px;
            line-height: 1.5;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .field-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .field-label,
        .field-label-row label {
            color: var(--on-surface-variant);
            font-size: 14px;
            font-weight: 500;
            line-height: 1;
        }

        .field-label-row span {
            color: var(--primary);
            font-size: 12px;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 8px;
            width: 18.5px;
            height: 18.5px;
            color: var(--outline);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .input-icon svg {
            width: 18.5px;
            height: 18.5px;
        }

        .login-input {
            display: block;
            width: 100%;
            height: 48px;
            padding: 0 16px 0 40px;
            border: 1px solid var(--outline-variant);
            border-radius: 4px;
            color: var(--on-surface) !important;
            background-color: var(--field-bg) !important;
            font-size: 14px;
            line-height: 1.5;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }

        .input-wrap > .login-input {
            padding-left: 48px !important;
        }

        .input-wrap > #password.login-input {
            padding-right: 48px !important;
        }

        .login-input::placeholder {
            color: color-mix(in srgb, var(--outline-variant) 70%, transparent);
        }

        .login-input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(0, 74, 198, 0.2);
        }

        .login-input:-webkit-autofill,
        .login-input:-webkit-autofill:hover,
        .login-input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px var(--field-bg) inset !important;
            -webkit-text-fill-color: var(--on-surface) !important;
            caret-color: var(--on-surface);
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 4px;
            border: 0;
            color: var(--outline);
            background: transparent;
            cursor: pointer;
            transform: translateY(-50%);
        }

        .password-toggle:hover {
            color: var(--on-surface);
        }

        .password-toggle svg {
            width: 20px;
            height: 20px;
        }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .remember-row label {
            color: var(--on-surface-variant);
            font-size: 14px;
            line-height: 1.5;
            cursor: pointer;
            user-select: none;
        }

        .remember-row input {
            width: 16px;
            height: 16px;
            margin: 0;
            accent-color: var(--primary);
        }

        .login-submit {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 48px;
            margin-top: 8px;
            border: 0;
            border-radius: 4px;
            color: #ffffff;
            background: var(--primary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 160ms ease, box-shadow 160ms ease;
        }

        .login-submit:hover {
            background: var(--primary-hover);
            box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
        }

        .totp-input {
            padding-left: 16px;
            text-align: center;
            font-size: 24px;
            letter-spacing: 4px;
        }

        .totp-help {
            margin: 4px 0 0;
            color: var(--on-surface-variant);
            font-size: 14px;
            line-height: 1.5;
        }

        .restart-link {
            display: block;
            margin-top: 16px;
            color: var(--primary);
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            text-decoration: none;
        }

        .restart-link:hover {
            text-decoration: underline;
        }

        .client-name {
            margin-top: 24px;
            color: var(--on-surface-variant);
            font-size: 12px;
            text-align: center;
        }

        .client-name strong {
            color: var(--on-surface);
        }

        .auth-footer {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            width: 100%;
            padding: 24px 16px;
            border-top: 1px solid var(--outline-variant);
            color: var(--on-surface-variant);
            background: var(--card-bg);
            font-size: 12px;
            text-align: center;
        }

        .auth-footer-brand {
            color: var(--on-surface);
            font-size: 20px;
            font-weight: 600;
        }

        .auth-footer-links {
            display: flex;
            gap: 16px;
        }

        .auth-footer a {
            color: var(--on-surface-variant);
            text-decoration: none;
        }

        .auth-footer a:hover {
            color: var(--primary);
        }

        .slider-captcha-scene {
            background:
                linear-gradient(125deg, rgba(0, 74, 198, 0.92), rgba(37, 99, 235, 0.8)),
                repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.14) 0 2px, transparent 2px 14px);
        }

        .slider-captcha-piece {
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
            transition: none;
            will-change: transform;
        }

        #slider-captcha-handle,
        #slider-captcha-progress {
            will-change: transform;
        }

        #slider-captcha-progress {
            transform-origin: left center;
        }

        .slider-captcha-dialog {
            z-index: 2147483647;
        }

        @@media (min-width: 768px) {
            .auth-shell {
                flex-direction: row;
            }

            .auth-brand-panel {
                position: relative;
                display: flex;
                width: 50%;
                min-height: max(884px, 100dvh);
                align-items: center;
                padding: 40px;
                overflow: hidden;
                background: var(--brand-bg);
            }

            .auth-brand-panel::after {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(0, 74, 198, 0.1), transparent 52%);
                content: "";
                pointer-events: none;
            }

            .auth-brand-content {
                position: relative;
                z-index: 1;
                width: min(100%, 448px);
                margin: 0 auto;
            }

            .brand-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 24px;
            }

            .brand-name {
                font-size: 36px;
                line-height: 1.2;
            }

            .brand-title {
                margin: 0 0 16px;
                color: var(--on-surface);
                font-size: 30px;
                font-weight: 700;
                line-height: 1.1;
            }

            .brand-description {
                max-width: 384px;
                margin: 0;
                color: var(--on-surface-variant);
                font-size: 14px;
                line-height: 1.6;
            }

            .auth-form-panel {
                min-height: max(884px, 100dvh);
                padding: 40px;
            }

            .mobile-brand,
            .mobile-only {
                display: none;
            }

            .auth-card {
                margin-top: 0;
                padding: 40px;
                box-shadow: none;
            }

            .card-mobile-brand {
                display: none;
            }

            .auth-card-header {
                margin-bottom: 24px;
            }

            .auth-footer {
                display: none;
            }
        }

        @@media (max-width: 767px) {
            .brand-corner {
                top: 20px;
                left: 20px;
            }

            .desktop-only {
                display: none;
            }

            .mobile-only {
                display: block;
            }

            .auth-card-header {
                text-align: center;
            }

            .auth-card-title {
                margin-bottom: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="切换至亮色模式" title="切换主题">☼</button>
        <a class="brand-corner" href="/" aria-label="@Model.LoginPage.BrandName">
            <img class="brand-mark" src="@Model.LoginPage.BrandLogoUrl" alt="" />
            <span>@Model.LoginPage.BrandName</span>
        </a>

        <aside class="auth-brand-panel" aria-label="NexusAuth">
            <div class="auth-brand-content">
                <h1 class="brand-title">@Model.LoginPage.MarketingHeading</h1>
                <p class="brand-description">@Model.LoginPage.MarketingDescription</p>
            </div>
        </aside>

        <main class="auth-form-panel">
            <section class="auth-card" aria-labelledby="login-title">
                <header class="auth-card-header">
                    <h1 id="login-title" class="auth-card-title">@(Model.RequiresTotp ? "验证身份" : Model.LoginPage.LoginTitle)</h1>
                    <p class="auth-card-subtitle mobile-only">@Model.LoginPage.LoginSubtitle</p>
                </header>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="auth-error">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (Model.RequiresTotp)
                    {
                    <form class="login-form" method="post" asp-page-handler="Totp">
                        <input type="hidden" asp-for="FlowToken" />
                        <div class="form-field">
                            <div class="field-label-row">
                                <label asp-for="TotpCode">身份验证器代码</label>
                                <span>第二步</span>
                            </div>
                            <input class="login-input totp-input"
                                   asp-for="TotpCode"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   maxlength="6"
                                   pattern="[0-9]{6}"
                                   placeholder="000000"
                                   required
                                   autofocus />
                            <p class="totp-help">输入身份验证器应用当前显示的六位代码。</p>
                        </div>
                        <button class="login-submit" type="submit">
                            验证并登录
                        </button>
                        <a class="restart-link" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">重新开始</a>
                    </form>
                    }
                    else
                    {
                    <form id="login-form" class="login-form" method="post">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        @if (Model.SliderCaptchaEnabled)
                        {
                        <input id="slider-captcha-token" type="hidden" asp-for="SliderCaptchaToken" />
                        <input id="slider-captcha-offset" type="hidden" asp-for="SliderCaptchaOffset" />
                        }

                        <div class="form-field">
                            <label class="field-label" for="username">Username or Email</label>
                            <div class="input-wrap">
                                <span class="input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 20.118a7.5 7.5 0 0 1 15 0A17.93 17.93 0 0 1 12 21.75a17.93 17.93 0 0 1-7.5-1.632Z" />
                                        </svg>
                                </span>
                                <input class="login-input"
                                       id="username"
                                       name="Username"
                                       placeholder="admin@nexusauth.local"
                                       required
                                       type="text"
                                       value="@Model.Username"
                                       autofocus />
                            </div>
                        </div>

                        <div class="form-field">
                            <div class="field-label-row">
                                <label for="password">Password</label>
                                <span>安全接入</span>
                            </div>
                            <div class="input-wrap">
                                <span class="input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V7.875a4.5 4.5 0 1 0-9 0V10.5m-.75 0h10.5A2.25 2.25 0 0 1 19.5 12.75v6A2.25 2.25 0 0 1 17.25 21h-10.5A2.25 2.25 0 0 1 4.5 18.75v-6A2.25 2.25 0 0 1 6.75 10.5Z" />
                                        </svg>
                                </span>
                                <input class="login-input"
                                       id="password"
                                       name="Password"
                                       placeholder="••••••••"
                                       required
                                       type="password" />
                                <button class="password-toggle" type="button" id="password-toggle" aria-label="显示密码">
                                    <span id="password-toggle-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.437 0 .644C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                        </svg>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="remember-row">
                            @if (Model.ShowRememberMe)
                            {
                            <label>
                                <input asp-for="RememberMe" type="checkbox" />
                                记住我
                            </label>
                            }
                        </div>

                        <button class="login-submit" type="submit">@Model.LoginPage.LoginTitle</button>
                    </form>

                    @if (Model.SliderCaptchaEnabled)
                    {
                    <div id="slider-captcha-dialog" class="slider-captcha-dialog fixed inset-0 hidden items-center justify-center bg-black/65 p-4" role="dialog" aria-modal="true" aria-labelledby="slider-captcha-title">
                        <div class="w-full max-w-[420px] rounded-lg border border-[color:var(--outline-variant)]/40 bg-[var(--surface-container)] p-6 shadow-2xl">
                            <div class="mb-5 flex items-start justify-between gap-4">
                                <div>
                                    <h2 id="slider-captcha-title" class="font-headline text-lg font-bold text-[var(--on-surface)]">安全验证</h2>
                                    <p class="mt-1 text-sm text-[var(--on-surface-variant)]">拖动滑块，将拼图移动到缺口位置。</p>
                                </div>
                                <button id="slider-captcha-close" type="button" class="text-xl text-[var(--on-surface-variant)] hover:text-[var(--on-surface)]" aria-label="关闭验证">&times;</button>
                            </div>
                            <div id="slider-captcha-scene" class="slider-captcha-scene relative mx-auto h-40 w-full overflow-hidden rounded-md border border-white/20" data-target="@Model.SliderCaptchaTargetOffsetPixels" data-tolerance="@Model.SliderCaptchaTolerancePixels" data-track-width="@Model.SliderCaptchaTrackWidthPixels">
                                <div class="absolute inset-0 opacity-40" style="background-image: radial-gradient(circle at 16% 25%, white 0 2px, transparent 3px), radial-gradient(circle at 75% 72%, white 0 3px, transparent 4px), linear-gradient(135deg, transparent 42%, rgba(255,255,255,.42) 43% 47%, transparent 48%);"></div>
                                <div id="slider-captcha-gap" class="absolute top-[52px] h-11 w-11 rounded-md border-2 border-dashed border-white/80 bg-black/20" aria-hidden="true"></div>
                                <div id="slider-captcha-piece" class="slider-captcha-piece absolute top-[52px] h-11 w-11 rounded-md border border-white/80 bg-white/35 backdrop-blur-sm" aria-hidden="true"></div>
                            </div>
                            <div id="slider-captcha-track" class="relative mt-5 h-12 select-none rounded-md bg-[var(--surface-container-highest)]" aria-label="拖动完成安全验证">
                                <div id="slider-captcha-progress" class="absolute inset-y-0 left-0 rounded-md bg-[color:var(--primary)]/30"></div>
                                <span class="pointer-events-none absolute inset-0 flex items-center justify-center text-sm text-[var(--on-surface-variant)]">按住滑块向右拖动</span>
                                <button id="slider-captcha-handle" type="button" class="absolute left-0 top-0 flex h-12 w-12 touch-none items-center justify-center rounded-md bg-[color:var(--primary)] text-white shadow-lg" aria-label="拖动滑块">
                                    <span aria-hidden="true">&raquo;</span>
                                </button>
                            </div>
                            <p id="slider-captcha-status" class="mt-3 min-h-5 text-center text-sm text-[var(--on-surface-variant)]" aria-live="polite"></p>
                        </div>
                    </div>
                    }
                    }

                    @if (!string.IsNullOrEmpty(Model.AuthorizationClientDisplayName))
                    {
                        <div class="client-name">
                            当前授权客户端：<span class="font-semibold text-[var(--on-surface)]">@Model.AuthorizationClientDisplayName</span>
                        </div>
                    }
            </section>
        </main>

        <footer class="auth-footer">
            <strong class="auth-footer-brand">@Model.LoginPage.BrandName</strong>
            <div class="auth-footer-links"><a href="#">Privacy Policy</a><a href="#">Terms of Service</a></div>
            <span>© 2024 NexusAuth. All rights reserved.</span>
        </footer>
    </div>

    <script>
        (function () {
            const root = document.documentElement;
            const toggle = document.getElementById('theme-toggle');
            const storageKey = 'nexusauth-login-theme';
            const stored = window.localStorage.getItem(storageKey);
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            function applyTheme(theme) {
                root.classList.remove('light', 'dark');
                root.classList.add(theme);
                toggle.setAttribute('aria-label', theme === 'dark' ? '切换至亮色模式' : '切换至暗色模式');
                toggle.textContent = theme === 'dark' ? '☼' : '◐';
            }

            applyTheme(stored || (prefersDark ? 'dark' : 'light'));

            toggle.addEventListener('click', function () {
                const next = root.classList.contains('dark') ? 'light' : 'dark';
                window.localStorage.setItem(storageKey, next);
                applyTheme(next);
            });

            const passwordInput = document.getElementById('password');
            const passwordToggle = document.getElementById('password-toggle');
            const passwordToggleIcon = document.getElementById('password-toggle-icon');
            passwordToggle?.addEventListener('click', function () {
                const showing = passwordInput.type === 'text';
                passwordInput.type = showing ? 'password' : 'text';
                passwordToggle.setAttribute('aria-label', showing ? '显示密码' : '隐藏密码');
                passwordToggleIcon.innerHTML = showing
                    ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.437 0 .644C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>'
                    : '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" /><path stroke-linecap="round" stroke-linejoin="round" d="M10.477 10.488A3 3 0 0 0 12 15a3 3 0 0 0 2.121-.879" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A9.953 9.953 0 0 1 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.437 0 .644a10.01 10.01 0 0 1-4.02 5.278M6.228 6.228A9.956 9.956 0 0 0 2.036 11.678a1.012 1.012 0 0 0 0 .644C3.423 16.49 7.36 19.5 12 19.5a9.95 9.95 0 0 0 5.09-1.38" /></svg>';
            });

            const form = document.getElementById('login-form');
            const dialog = document.getElementById('slider-captcha-dialog');
            if (!form || !dialog) return;

            document.body.appendChild(dialog);

            const scene = document.getElementById('slider-captcha-scene');
            const gap = document.getElementById('slider-captcha-gap');
            const piece = document.getElementById('slider-captcha-piece');
            const track = document.getElementById('slider-captcha-track');
            const handle = document.getElementById('slider-captcha-handle');
            const progress = document.getElementById('slider-captcha-progress');
            const offsetInput = document.getElementById('slider-captcha-offset');
            const status = document.getElementById('slider-captcha-status');
            const close = document.getElementById('slider-captcha-close');
            let verified = false;
            let dragging = false;
            let startX = 0;
            let currentOffset = 0;
            let trackTravel = 0;
            let sceneTravel = 0;
            let handleWidth = 0;
            let pendingOffset = 0;
            let animationFrame = 0;

            function maxOffset() {
                return trackTravel;
            }

            function measure() {
                handleWidth = handle.clientWidth;
                trackTravel = Math.max(0, track.clientWidth - handleWidth);
                sceneTravel = Math.max(0, scene.clientWidth - piece.clientWidth);
                progress.style.width = `${track.clientWidth}px`;
            }

            function setPosition(offset) {
                currentOffset = Math.max(0, Math.min(maxOffset(), offset));
                const configuredWidth = Number(scene.dataset.trackWidth);
                const normalizedOffset = maxOffset() === 0 ? 0 : Math.round(currentOffset / maxOffset() * configuredWidth);
                const ratio = maxOffset() === 0 ? 0 : currentOffset / maxOffset();
                handle.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
                progress.style.transform = `scaleX(${Math.min(1, (currentOffset + handleWidth) / Math.max(1, track.clientWidth))})`;
                piece.style.transform = `translate3d(${ratio * sceneTravel}px, 0, 0)`;
                offsetInput.value = normalizedOffset;
            }

            function queuePosition(offset) {
                pendingOffset = offset;
                if (animationFrame) return;

                animationFrame = window.requestAnimationFrame(function () {
                    animationFrame = 0;
                    setPosition(pendingOffset);
                });
            }

            function prepare() {
                verified = false;
                offsetInput.value = '';
                status.textContent = '';
                measure();
                piece.style.left = '0px';
                setPosition(0);
                const configuredWidth = Number(scene.dataset.trackWidth);
                const target = Number(scene.dataset.target);
                gap.style.left = `${target / configuredWidth * (scene.clientWidth - gap.clientWidth)}px`;
            }

            function openDialog() {
                dialog.classList.remove('hidden');
                dialog.classList.add('flex');
                window.requestAnimationFrame(function () {
                    prepare();
                    handle.focus();
                });
            }

            function closeDialog() {
                dialog.classList.add('hidden');
                dialog.classList.remove('flex');
            }

            form.addEventListener('submit', function (event) {
                if (!verified) {
                    event.preventDefault();
                    openDialog();
                }
            });

            handle.addEventListener('pointerdown', function (event) {
                dragging = true;
                startX = event.clientX - currentOffset;
                handle.setPointerCapture(event.pointerId);
            });

            handle.addEventListener('pointermove', function (event) {
                if (dragging) queuePosition(event.clientX - startX);
            });

            handle.addEventListener('pointerup', function (event) {
                if (!dragging) return;
                dragging = false;
                handle.releasePointerCapture(event.pointerId);
                if (animationFrame) {
                    window.cancelAnimationFrame(animationFrame);
                    animationFrame = 0;
                }
                setPosition(event.clientX - startX);
                const target = Number(scene.dataset.target);
                const configuredWidth = Number(scene.dataset.trackWidth);
                const submittedOffset = Number(offsetInput.value);
                const tolerance = Number(scene.dataset.tolerance);
                if (Math.abs(submittedOffset - target) <= tolerance) {
                    verified = true;
                    status.textContent = '验证通过，正在提交...';
                    window.setTimeout(function () {
                        closeDialog();
                        form.requestSubmit();
                    }, 180);
                    return;
                }

                status.textContent = '请将拼图对准缺口后重试。';
                window.setTimeout(function () { setPosition(0); }, 300);
            });

            close.addEventListener('click', closeDialog);
            window.addEventListener('resize', function () {
                if (!dialog.classList.contains('hidden')) prepare();
            });
        })();
    </script>
</body>
</html>
