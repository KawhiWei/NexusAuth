@page
@model NexusAuth.Host.Pages.Account.RegisterModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>创建 NexusAuth 账号</title>
    <link rel="icon" type="image/svg+xml" href="/brand/nexusauth-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&amp;family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <script>
        (function () {
            const stored = window.localStorage.getItem('nexusauth-login-theme');
            const theme = stored === 'light' || stored === 'dark' ? stored : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.classList.add(theme);
        })();
    </script>
    <style>
        :root,html.light{--page:#f8fafc;--panel:#edf7ff;--grid:#b6d6ef;--tech:#10273b;--tech-muted:#587087;--tech-line:#2c7cb9;--glow:#2589d622;--node:#176caa;--stat:#ffffff99;--stat-border:#b9d7ee;--heading:#102030;--muted:#627282;--field:#fff;--border:#d6dee6;--blue:#2f8fe5;--button:#fff;--danger:#9f1239;--danger-bg:#fff1f2;--danger-border:#fecdd3;color-scheme:light}html.dark{--page:#10151b;--panel:#05080d;--grid:#172737;--tech:#f4faff;--tech-muted:#7b9bb5;--tech-line:#3f9ef2;--glow:#1479ce1f;--node:#d9f0ff;--stat:#ffffff0a;--stat-border:#ffffff1a;--heading:#f2f7fc;--muted:#91a1b1;--field:#171e26;--border:#2d3945;--blue:#54a9f4;--button:#07121f;--danger:#fda4af;--danger-bg:#4c051933;--danger-border:#9f123980;color-scheme:dark}*,*::before,*::after{box-sizing:border-box}html,body{min-height:100%;margin:0}body{min-width:320px;color:var(--heading);background:var(--page);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}button,input{font:inherit}
        .shell{display:grid;min-height:100dvh;grid-template-columns:minmax(0,58.854%) minmax(0,41.146%)}.visual{position:relative;min-height:100dvh;overflow:hidden;color:var(--tech);background-color:var(--panel);background-image:linear-gradient(to right,var(--grid) 1px,transparent 1px),linear-gradient(to bottom,var(--grid) 1px,transparent 1px);background-position:70px 0,0 92px;background-size:120px 100%,100% 120px}.visual::after{position:absolute;inset:0;background:linear-gradient(90deg,transparent 0 82%,color-mix(in srgb,var(--panel) 55%,transparent));content:"";pointer-events:none}.brand{position:absolute;top:6.85%;left:8.15%;z-index:2;display:flex;align-items:center;gap:13px;color:var(--tech);text-decoration:none}.brand-mark{display:grid;width:34px;height:34px;place-items:center;border-radius:7px;color:#fff;background:var(--blue);font-family:Geist,sans-serif;font-size:17px;font-weight:700}.brand-word{font-family:Geist,Inter,sans-serif;font-size:19px;font-weight:700;letter-spacing:2px}.system{position:absolute;top:26.1%;left:8.3%;z-index:2;display:flex;align-items:center;gap:8px;color:var(--tech-muted);font-size:11px;font-weight:700;letter-spacing:1.3px}.dot{width:8px;height:8px;border-radius:50%;background:#6beeb1;box-shadow:0 0 12px #6beeb199}.hero{position:absolute;top:31.1%;left:8.15%;z-index:2;width:min(49%,555px)}.hero h1{margin:0;font-family:Geist,Inter,sans-serif;font-size:clamp(42px,3vw,58px);font-weight:700;line-height:1.08}.hero p{max-width:480px;margin:23px 0 0;color:var(--tech-muted);font-size:clamp(15px,1vw,19px);line-height:1.5}.network{position:absolute;top:22%;left:55.6%;z-index:1;width:min(37.2vw,420px);aspect-ratio:1;border-radius:50%;background:var(--glow)}.orbit{position:absolute;top:50%;left:50%;border:1px solid var(--tech-line);border-radius:50%;transform:translate(-50%,-50%)}.outer{width:68.1%;height:68.1%;opacity:.75}.inner{width:41%;height:41%;opacity:.85}.core{position:absolute;top:50%;left:50%;width:8.1%;aspect-ratio:1;border-radius:50%;background:var(--blue);box-shadow:0 0 24px 4px color-mix(in srgb,var(--blue) 55%,transparent);transform:translate(-50%,-50%)}.node{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--node)}.n1{top:42.8%;left:21.4%}.n2{top:36.7%;right:29%}.n3{right:30.5%;bottom:25.2%}.n4{bottom:21.4%;left:32.4%}.stats{position:absolute;bottom:18.35%;left:8.3%;z-index:2;display:grid;width:min(50.5%,570px);min-width:490px;grid-template-columns:repeat(3,1fr);border:1px solid var(--stat-border);border-radius:8px;background:var(--stat);backdrop-filter:blur(8px)}.stat{min-width:0;padding:24px 26px}.stat+.stat{border-left:1px solid var(--stat-border)}.stat strong{display:block;font-family:Geist,Inter,sans-serif;font-size:24px;font-weight:600}.stat span{display:block;margin-top:8px;color:var(--tech-muted);font-size:10px;font-weight:700;letter-spacing:.9px}.footer{position:absolute;right:9.4%;bottom:7.1%;left:8.3%;z-index:2;display:flex;justify-content:space-between;color:var(--tech-muted);font-size:10px;font-weight:600;letter-spacing:1px}
        .form-panel{position:relative;min-width:0;min-height:100dvh;overflow-y:auto;background:var(--page)}.utility{position:absolute;top:68px;right:clamp(36px,5.52vw,106px);z-index:2}.theme-toggle{position:relative;display:grid;width:78px;height:34px;grid-template-columns:1fr 1fr;align-items:center;padding:3px;border:1px solid var(--border);border-radius:17px;color:var(--muted);background:var(--field);cursor:pointer}.theme-toggle::before{position:absolute;top:2px;left:2px;width:28px;height:28px;border-radius:50%;background:var(--blue);content:"";transition:transform 180ms ease}html.dark .theme-toggle::before{transform:translateX(44px)}.theme-icon{position:relative;z-index:1;display:grid;place-items:center}.theme-icon svg{width:14px;height:14px}html.light .sun,html.dark .moon{color:var(--button)}.mobile-brand{display:none}.register{width:min(calc(100% - 72px),578px);margin:0 auto;padding:clamp(84px,8.4vh,96px) 0 56px}.eyebrow{margin:0 0 8px;color:var(--blue);font-size:11px;font-weight:700;letter-spacing:1.4px}.title{margin:0;font-family:Geist,Inter,sans-serif;font-size:clamp(34px,2.04vw,39px);font-weight:700;line-height:1.15}.subtitle{margin:10px 0 0;color:var(--muted);font-size:15px;line-height:1.5}.error{margin:20px 0 0;padding:12px 14px;border:1px solid var(--danger-border);border-radius:6px;color:var(--danger);background:var(--danger-bg);font-size:13px;line-height:1.5}.register-form{display:flex;flex-direction:column;gap:14px;margin-top:28px}.error+.register-form{margin-top:20px}.row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field-group{display:flex;flex-direction:column;gap:7px;min-width:0}.field-head{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}.field-head label{overflow:hidden;font-size:12px;font-weight:600;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}.meta{flex:0 0 auto;color:var(--muted);font-size:11px}.input-wrap{position:relative}.input-icon{position:absolute;top:50%;left:14px;display:grid;width:16px;height:16px;place-items:center;color:var(--muted);pointer-events:none;transform:translateY(-50%)}.input-icon svg{width:16px;height:16px}.input{display:block;width:100%;height:48px;padding:0 14px 0 40px;border:1px solid var(--border);border-radius:6px;outline:0;color:var(--heading);background:var(--field);font-size:13px;transition:border-color 160ms ease,box-shadow 160ms ease}.input::placeholder{color:var(--muted);opacity:.92}.input:focus{border-color:var(--blue);box-shadow:0 0 0 3px color-mix(in srgb,var(--blue) 20%,transparent)}.input:-webkit-autofill{-webkit-box-shadow:0 0 0 1000px var(--field) inset;-webkit-text-fill-color:var(--heading)}.password{padding-right:42px}.password-toggle{position:absolute;top:50%;right:6px;display:grid;width:36px;height:36px;place-items:center;padding:0;border:0;border-radius:4px;color:var(--muted);background:transparent;cursor:pointer;transform:translateY(-50%)}.password-toggle:hover{color:var(--heading);background:color-mix(in srgb,var(--muted) 10%,transparent)}.password-toggle svg{width:16px;height:16px}.validation{min-height:15px;color:var(--danger);font-size:11px;line-height:1.35}.security{display:flex;align-items:center;gap:8px;margin:0;color:var(--muted);font-size:12px}.security svg{width:14px;height:14px;flex:0 0 auto;color:var(--blue)}.submit{display:flex;width:100%;height:54px;align-items:center;justify-content:center;gap:10px;border:0;border-radius:6px;color:var(--button);background:var(--blue);font-size:14px;font-weight:700;cursor:pointer;transition:filter 160ms ease,transform 160ms ease}.submit:hover{filter:brightness(.94)}.submit:active{transform:translateY(1px)}.submit svg{width:17px;height:17px}.login-link{margin:8px 0 0;color:var(--muted);font-size:13px;text-align:center}.login-link a{color:var(--blue);font-weight:600;text-decoration:none}.login-link a:hover{text-decoration:underline}:where(.theme-toggle,.password-toggle,.submit,.login-link a):focus-visible{outline:2px solid var(--blue);outline-offset:3px}
        @@media(max-width:1099px){.shell{display:block}.visual{display:none}.form-panel{padding:0 24px}.utility{top:24px;right:24px}.mobile-brand{position:absolute;top:24px;left:24px;display:flex;color:var(--heading)}.register{width:min(100%,578px);padding-top:116px}}@@media(max-width:600px){.form-panel{padding:0 20px}.mobile-brand{top:20px;left:20px}.utility{top:20px;right:20px}.register{padding-top:100px}.title{font-size:31px}.subtitle{font-size:14px}.row{grid-template-columns:1fr;gap:14px}}
    </style>
</head>
<body>
    <div class="shell">
        <aside class="visual" aria-label="NexusAuth 产品介绍">
            <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">N</span><span class="brand-word">NEXUSAUTH</span></a>
            <div class="system"><span class="dot"></span><span>连接智能</span></div>
            <div class="hero"><h1>以清晰速度，<br />驱动每一次决策。</h1><p>NexusAuth 将身份、系统和应用汇聚为统一且可信的访问控制层。</p></div>
            <div class="network" aria-hidden="true"><span class="orbit outer"></span><span class="orbit inner"></span><span class="core"></span><span class="node n1"></span><span class="node n2"></span><span class="node n3"></span><span class="node n4"></span></div>
            <div class="stats" aria-label="支持的标准协议"><div class="stat"><strong>OAuth 2.1</strong><span>授权协议</span></div><div class="stat"><strong>OIDC</strong><span>身份认证</span></div><div class="stat"><strong>SCIM 2.0</strong><span>用户配置</span></div></div>
            <div class="footer"><span>加密会话 / AES-256</span><span>NEXUSAUTH SSO</span></div>
        </aside>
        <main class="form-panel">
            <a class="brand mobile-brand" href="/"><span class="brand-mark" aria-hidden="true">N</span><span class="brand-word">NEXUSAUTH</span></a>
            <div class="utility"><button id="theme-toggle" type="button" class="theme-toggle" aria-label="切换主题" title="切换主题"><span class="theme-icon sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg></span><span class="theme-icon moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg></span></button></div>
            <section class="register" aria-labelledby="register-title">
                <p class="eyebrow">创建 NEXUSAUTH 账号</p><h1 id="register-title" class="title">创建账号</h1><p class="subtitle">填写以下必要信息，即可创建 NexusAuth 登录账号。</p>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="error" role="alert">@Model.ErrorMessage</div> }
                <form class="register-form" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="row">
                        <div class="field-group"><div class="field-head"><label asp-for="Username">登录账号</label><span class="meta">3-64 位</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 5h14v14H5z" /><path d="M8 9h8M8 13h5" /></svg></span><input class="input" asp-for="Username" autocomplete="username" placeholder="例如：jane.doe" autofocus /></div><span class="validation" asp-validation-for="Username"></span></div>
                        <div class="field-group"><div class="field-head"><label asp-for="Nickname">用户名</label><span class="meta">2-64 位</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3" /><path d="M5 20c.8-3.3 3.1-5 7-5s6.2 1.7 7 5" /></svg></span><input class="input" asp-for="Nickname" autocomplete="name" placeholder="例如：Jane Doe" /></div><span class="validation" asp-validation-for="Nickname"></span></div>
                    </div>
                    <div class="field-group"><div class="field-head"><label asp-for="Email">邮箱地址</label><span class="meta">必填</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="6" width="16" height="12" rx="1" /><path d="m4 7 8 6 8-6" /></svg></span><input class="input" asp-for="Email" autocomplete="email" placeholder="name@example.com" /></div><span class="validation" asp-validation-for="Email"></span></div>
                    <div class="row">
                        <div class="field-group"><div class="field-head"><label asp-for="Password">密码</label><span class="meta">至少 8 位</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span><input class="input password" asp-for="Password" type="password" autocomplete="new-password" placeholder="至少 8 位字符" /><button class="password-toggle" type="button" data-password-toggle="Password" aria-label="显示密码"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg></button></div><span class="validation" asp-validation-for="Password"></span></div>
                        <div class="field-group"><div class="field-head"><label asp-for="ConfirmPassword">确认密码</label><span class="meta">必须一致</span></div><div class="input-wrap"><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12V7a4 4 0 0 1 8 0v2" /><rect x="5" y="10" width="14" height="11" rx="2" /><path d="m9 15 2 2 4-4" /></svg></span><input class="input password" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="再次输入密码" /><button class="password-toggle" type="button" data-password-toggle="ConfirmPassword" aria-label="显示确认密码"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg></button></div><span class="validation" asp-validation-for="ConfirmPassword"></span></div>
                    </div>
                    <p class="security"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 5 6v5c0 4.2 2.9 8.1 7 10 4.1-1.9 7-5.8 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>密码将以安全哈希方式保存。</p>
                    <button class="submit" type="submit"><span>创建账号</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
                    <p class="login-link">已有账号？<a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">返回登录</a></p>
                </form>
            </section>
        </main>
    </div>
    <script>
        (function () {
            const root = document.documentElement, toggle = document.getElementById('theme-toggle');
            function apply(theme) { root.classList.remove('light','dark'); root.classList.add(theme); toggle.setAttribute('aria-label', theme === 'dark' ? '切换至亮色模式' : '切换至暗色模式'); }
            apply(root.classList.contains('dark') ? 'dark' : 'light');
            toggle.addEventListener('click', function () { const next = root.classList.contains('dark') ? 'light' : 'dark'; window.localStorage.setItem('nexusauth-login-theme', next); apply(next); });
            document.querySelectorAll('[data-password-toggle]').forEach(function (button) { button.addEventListener('click', function () { const input = document.getElementById(button.dataset.passwordToggle), showing = input.type === 'text'; input.type = showing ? 'password' : 'text'; button.setAttribute('aria-label', showing ? '显示密码' : '隐藏密码'); }); });
        })();
    </script>
</body>
</html>
