{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    }
  },
  "LuckLogging": {
    "Module": "NexusAuth.SSO",
    "FilePath": "logs/nexusauth-sso-.log",
    "MinimumLevel": "Information",
    "MinimumLevelOverrides": {
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    },
    "FileSizeLimitBytes": 104857600,
    "RetainedFileCountLimit": 30,
    "RollOnFileSizeLimit": true,
    "Shared": true,
    "FlushIntervalSeconds": 1
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "User ID=postgres;Password=wzw0126..;Host=localhost;Port=5432;Database=nexusauth;Search Path=nexusauth"
  },
  "Jwt": {
    "Issuer": "http://localhost:5100",
    "DefaultAudience": "NexusAuth",
    "SigningMode": "Certificate",
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "SigningKeyPath": "",
    "AccessTokenLifetimeMinutes": 60,
    "DeviceCodeLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 43200
  },
  "Security": {
    "ClientWhitelist": [],
    "ClientBlacklist": [],
    "UserWhitelist": [],
    "UserBlacklist": [],
    "LoginFailureLimit": 5,
    "LoginLockoutMinutes": 5
  },
  "LoginFlow": {
    "PendingStateLifetimeMinutes": 5,
    "SessionLifetimeMinutes": 1440,
    "AllowRememberMe": true,
    "Steps": [
      {
        "Type": "password",
        "Requirement": "required"
      },
      {
        "Type": "totp",
        "Requirement": "conditional"
      }
    ]
  },
  "LoginPage": {
    "BrandName": "NexusAuth",
    "BrandLogoUrl": "/brand/nexusauth-logo.svg",
    "MarketingHeading": "基于 OAuth 2.1 与 OIDC 的统一身份认证",
    "MarketingDescription": "支持 OAuth 2.1、OpenID Connect（OIDC）、授权码 + PKCE 和 SCIM 2.0 标准协议。",
    "LoginTitle": "Sign In",
    "LoginSubtitle": "Please enter your details to sign in."
  },
  "Totp": {
    "Issuer": "NexusAuth",
    "EnrollmentLifetimeMinutes": 10
  },
  "SliderCaptcha": {
    "Enabled": false,
    "ChallengeLifetimeSeconds": 120,
    "TolerancePixels": 5,
    "TrackWidthPixels": 300
  },
  "BootstrapAdmin": {
    "Username": "",
    "Password": "",
    "Nickname": "System Admin",
    "Email": ""
  }
}
